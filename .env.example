PORT=3000
DB_PATH=.runtime/academy.sqlite
# Optional, server-only Gemini key. Use a project without paid billing for a free-only demo.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_DAILY_REQUEST_LIMIT=40
AI_ALLOWED_ORIGINS=https://kendallw64.github.io,http://localhost:3000,http://127.0.0.1:3000
# On Pages this is only the public HTTPS Worker URL, never an API key.
# VITE_AI_API_URL=https://sportsstats-academy-ai.YOUR-SUBDOMAIN.workers.dev
# TRUST_PROXY=1  # Only when the Node service is behind exactly one trusted reverse proxy.
