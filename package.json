{
  "name": "sportsstats-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --use-env-proxy --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "build:pages": "VITE_DEPLOY_TARGET=pages VITE_BASE_PATH=/Stat_Learning_App/ vite build --outDir dist-pages",
    "preview:pages": "vite preview --outDir dist-pages --host 127.0.0.1 --port 4173 --strictPort --base /Stat_Learning_App/",
    "test:pages": "npm run build:pages && playwright test --config playwright.pages.config.js",
    "deploy:ai": "wrangler deploy",
    "dev:ai": "wrangler dev --local --port 8787",
    "check:ai": "wrangler deploy --dry-run --outdir .worker-build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.1.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=24.5.0 <25"
  }
}
